# Réglages de installer.py (copier en .env, ne jamais publier le .env).
# n8n : adresse vue depuis votre poste, compte qui possédera le workflow (un compte membre suffit).
N8N_URL=http://n8n.localhost:8080
N8N_EMAIL=
N8N_MOT_DE_PASSE=
# Adresse de n8n vue depuis le conteneur Open WebUI : le service Kubernetes, jamais localhost.
N8N_INTERNE=http://n8n.n8n.svc.cluster.local:5678
# Jeton partagé entre n8n (identifiant Bearer) et Open WebUI (clé de la connexion).
# Laisser vide : installer.py en tire un au hasard et l'affiche une fois.
JETON_MCP=
# Open WebUI : adresse et jeton d'un compte administrateur (Réglages › Compte › Clés d'API).
OWUI_URL=http://127.0.0.1:8080
OWUI_JETON=
# Modèle de base de l'assistant (identifiant tel qu'Open WebUI le liste), capable d'appeler des outils.
MODELE_BASE=
